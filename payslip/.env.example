# Base URL for your Node.js + Express + Mongoose backend.
# No trailing slash. Example: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (from Google Cloud Console — same one used by your backend)
# Used by Google Identity Services on the frontend to obtain an ID token,
# which is then POSTed to {VITE_API_URL}/auth/google for verification.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
